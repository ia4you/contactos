# Copia este archivo a .env.local y rellena los valores reales.
# .env.local nunca se sube a git (ver .gitignore).

DATABASE_URL=postgresql://usuario:password@host:5432/basededatos
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://contactos.turel.es

SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# console.groq.com — motor de recomendaciones con IA (Sprint 6)
GROQ_API_KEY=

# https://console.cloud.google.com/google/maps-apis — Places API (New) o
# Places API clásica, habilitada para "Place Autocomplete". Restringe la key
# por API (Places) y, si es posible, por dominio/IP del servidor.
# Sin esta variable, el campo "Lugar" de /eventos funciona como input normal
# sin autocompletado (fallback silencioso, no rompe nada).
GOOGLE_PLACES_API_KEY=
